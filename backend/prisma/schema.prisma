// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  cashier
  barista
  kitchen
  server
}

enum OrderStatus {
  Pending
  Preparing
  Served
  Paid
}

enum OrderItemStatus {
  Pending
  Preparing
  Ready
}

enum PaymentStatus {
  Pending
  Completed
  Failed
}

enum StockType {
  kitchen
  barista
  both
}

enum StockOrderStatus {
  Pending
  Ordered
  Received
}

// ============================================================
// USERS
// ============================================================

model User {
  user_id    Int      @id @default(autoincrement())
  username   String   @unique @db.VarChar(100)
  password   String   @db.VarChar(255)
  email      String   @unique @db.VarChar(150)
  role       Role
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  orders          Order[]
  payments        Payment[]
  stock_orders    StockOrder[]

  @@map("users")
}

// ============================================================
// TABLES
// ============================================================

model Table {
  table_id     Int     @id @default(autoincrement())
  table_number String  @unique @db.VarChar(20)
  capacity     Int
  is_available Boolean @default(true)
  qr_token     String  @unique @db.VarChar(64)
  // Unguessable per-table token used in QR codes instead of the sequential
  // table_id, so scanning the real printed QR is the only practical way
  // for a guest to land on a real table's order page.

  // Relations
  orders Order[]
  guest_sessions GuestSession[]

  @@map("tables")
}

// ============================================================
// GUEST SESSIONS
// Issued once when a guest scans a table's QR code. All subsequent
// guest API calls carry this session's token instead of resending the
// QR token or a client-supplied table_id, so the server always derives
// table_id from a verified, expiring session rather than trusting
// whatever the request body claims.
// ============================================================

model GuestSession {
  session_id Int      @id @default(autoincrement())
  token_hash String   @unique @db.VarChar(64)
  // SHA-256 hex digest of the raw 256-bit session token. Only the hash
  // is ever persisted — the raw token is returned to the guest once, at
  // creation, the same way a password reset token is handled.
  table_id   Int
  table      Table    @relation(fields: [table_id], references: [table_id])
  created_at DateTime @default(now())
  expires_at DateTime

  @@index([expires_at])
  @@map("guest_sessions")
}

// ============================================================
// MENU CATEGORIES
// type: "food" or "drink" — used to route to kitchen or barista
// ============================================================

model MenuCategory {
  category_id   Int    @id @default(autoincrement())
  category_name String @unique @db.VarChar(100)
  type          String @db.VarChar(10) // "food" or "drink"

  // Relations
  menu_items MenuItem[]

  @@map("menu_categories")
}

// ============================================================
// MENU ITEMS
// price stored directly here — no separate prices table
// ============================================================

model MenuItem {
  menu_item_id      Int     @id @default(autoincrement())
  item_name         String  @db.VarChar(150)
  item_name_km      String? @db.VarChar(150) // Khmer name; falls back to item_name when empty
  category_id       Int
  price             Decimal @db.Decimal(10, 2)
  available         Boolean @default(true)
  image_url         String?

  // Relations
  category    MenuCategory @relation(fields: [category_id], references: [category_id])
  order_items OrderItem[]

  @@map("menu_items")
}

// ============================================================
// ORDERS
// user_id is nullable — null means guest order via QR
// ============================================================

model Order {
  order_id   Int         @id @default(autoincrement())
  order_date DateTime    @default(now())
  status     OrderStatus @default(Pending)
  note       String?     @db.Text
  party_size Int?        // number of customers, optionally set when the order is created — helps the kitchen gauge prep quantity
  table_id   Int
  user_id    Int?        // null = guest
  confirmed  Boolean     @default(true)
  // Guest orders (user_id null) are created with confirmed = false by
  // createOrder — see order.controller.js. Staff-placed orders stay true
  // since there's no anonymity to verify. Kitchen/barista queues only
  // pull confirmed = true items, so an unconfirmed guest order never
  // reaches the kitchen until a cashier approves it (the prank/ghost
  // order confirmation gate).

  // Relations
  table       Table       @relation(fields: [table_id], references: [table_id])
  user        User?       @relation(fields: [user_id], references: [user_id])
  order_items OrderItem[]
  payments    Payment[]

  @@map("orders")
}

// ============================================================
// ORDER ITEMS
// ============================================================

model OrderItem {
  order_item_id Int             @id @default(autoincrement())
  order_id      Int
  menu_item_id  Int
  quantity      Int
  unit_price    Decimal         @db.Decimal(10, 2)
  status        OrderItemStatus @default(Pending)
  note          String?         @db.VarChar(255)
  // Per-item note (e.g. "no ice", "extra spicy", "peanut allergy") — distinct
  // from Order.note, which is a whole-order note set at checkout. Lets a
  // guest/cashier attach a request to one specific line instead of the
  // whole order, so kitchen/barista know exactly which item it applies to.

  // Relations
  order     Order    @relation(fields: [order_id], references: [order_id])
  menu_item MenuItem @relation(fields: [menu_item_id], references: [menu_item_id])

  @@map("order_items")
}

// ============================================================
// PAYMENT METHODS
// ============================================================

model PaymentMethod {
  method_id   Int    @id @default(autoincrement())
  method_name String @unique @db.VarChar(50)

  // Relations
  payments Payment[]

  @@map("payment_methods")
}

// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  payment_id   Int           @id @default(autoincrement())
  payment_date DateTime      @default(now())
  amount       Decimal       @db.Decimal(10, 2)
  method_id    Int
  status       PaymentStatus @default(Pending)
  order_id     Int
  user_id      Int

  // Relations
  method PaymentMethod @relation(fields: [method_id], references: [method_id])
  order  Order         @relation(fields: [order_id], references: [order_id])
  user   User          @relation(fields: [user_id], references: [user_id])

  @@map("payments")
}

// ============================================================
// UNITS
// ============================================================

model Unit {
  unit_id   Int    @id @default(autoincrement())
  unit_name String @unique @db.VarChar(50)

  // Relations
  stock Stock[]

  @@map("units")
}

// ============================================================
// STOCK
// ============================================================

model Stock {
  stock_id     Int      @id @default(autoincrement())
  item_name    String   @db.VarChar(150)
  quantity     Decimal  @db.Decimal(10, 2)
  unit_id      Int
  min_level    Decimal?  @db.Decimal(10, 2)
  image_url    String?   @db.VarChar(255)
  stock_type   StockType @default(both)
  last_updated DateTime  @updatedAt

  // Relations
  unit         Unit         @relation(fields: [unit_id], references: [unit_id])
  stock_orders StockOrder[]

  @@map("stock")
}

// ============================================================
// STOCK ORDERS
// status: Pending → Ordered → Received
// On Received: admin manually updates stock quantity
// ============================================================

model StockOrder {
  stock_order_id Int              @id @default(autoincrement())
  invoice        String?          @db.VarChar(100)
  quantity       Decimal          @db.Decimal(10, 2)
  status         StockOrderStatus @default(Pending)
  user_id        Int
  stock_id       Int
  supplier_id    Int

  // Relations
  user     User     @relation(fields: [user_id], references: [user_id])
  stock    Stock    @relation(fields: [stock_id], references: [stock_id])
  supplier Supplier @relation(fields: [supplier_id], references: [supplier_id])

  @@map("stock_orders")
}

// ============================================================
// SUPPLIERS
// ============================================================

model Supplier {
  supplier_id   Int     @id @default(autoincrement())
  supplier_name String  @db.VarChar(200)
  phone         String  @db.VarChar(20)
  email         String? @db.VarChar(150)

  // Relations
  stock_orders StockOrder[]

  @@map("suppliers")
}